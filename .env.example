# Database
# Local:
# DATABASE_URL="postgresql://user:password@localhost:5432/erm_db"
#
# Vercel + Supabase:
# Use the Supabase pooled connection string from Database > Connect > Transaction pooler.
# Recommended shape: postgresql://postgres.<project-ref>:<password>@aws-*-pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://user:password@localhost:5432/erm_db"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
EVIDENCE_DRIVE_URL="https://drive.google.com/drive/folders/1ME4zKW6vP1GwQu1KCTnXKfgihRITtd3C?usp=sharing"
WHATSAPP_PROVIDER="interakt"
WHATSAPP_ACCESS_TOKEN="replace-with-whatsapp-cloud-api-access-token"
WHATSAPP_PHONE_NUMBER_ID="replace-with-whatsapp-phone-number-id"
WHATSAPP_TEMPLATE_NAME="pengingat_penanganan_risiko"
WHATSAPP_TEMPLATE_LANGUAGE="id"
WHATSAPP_GRAPH_API_VERSION="v23.0"

# Interakt WhatsApp (port dari pusdiklat-gojags-backend EpdNotificationService)
# WHATSAPP_PROVIDER=interakt | graph | both
INTERAKT_ENABLED="false"
INTERAKT_ENDPOINT="https://api.interakt.ai/v1/public/message/"
INTERAKT_API_KEY="replace-with-interakt-api-key"
INTERAKT_AUTH_SCHEME="Basic"
INTERAKT_LANGUAGE_CODE="id"
INTERAKT_BUTTON_INDEX="0"
INTERAKT_TIMEOUT_MS="15000"
INTERAKT_WEBHOOK_SECRET="replace-with-interakt-webhook-secret"
INTERAKT_TEMPLATE_RTP_REMINDER="pengingat_penanganan_risiko"
INTERAKT_TEMPLATE_TEST="test_pengiriman_notifikasi"
NODE_ENV="development"
STORAGE_DRIVER="local"

# Optional shared cache for production/serverless.
# Without this, the app falls back to in-memory cache per warm function instance.
REDIS_URL=""

# AI
GEMINI_API_KEY="your-gemini-api-key"
GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="openai/gpt-oss-20b"
GROQ_SUMMARY_MAX_TOKENS="900"
GROQ_SUMMARY_CHUNK_SIZE="4500"
GROQ_SUMMARY_MAX_CHUNKS="3"

# OCR tuning for scanned PDFs.
# Lower values are faster; higher values improve OCR coverage/quality.
OCR_MAX_PAGES="3"
OCR_RENDER_WIDTH="1400"
TESSERACT_CACHE_PATH=".cache/tesseract"
TESSERACT_LANG_PATH=""

# GOJAGS Office Integration
GOJAGS_OFFICE_BASE_URL="https://gojags-office.etc-nso.id"
GOJAGS_OFFICE_API_KEY_RAPAT="your-gojags-office-rapat-api-key"
GOJAGS_OFFICE_API_KEY_TIM="your-gojags-office-tim-api-key"

# GOJAGS SSO Login
GOJAGS_AUTH_BASE_URL="https://gojags-api.bps.go.id/auth"
CLIENT_ID_GOJAGS="your-gojags-client-id"
GOJAGS_DEFAULT_ROLE="anggota tim"

# SMTP Configuration for Email Notifications
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="your-email@gmail.com"
SMTP_FROM_NAME="GOJAGS Risk"

# Cron Job Security
CRON_API_SECRET_KEY="your-random-secret-key"

# Client-side Firebase config
NEXT_PUBLIC_FIREBASE_API_KEY="your-public-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-public-firebase-app-id"
NEXT_PUBLIC_FIREBASE_VAPID_KEY="your-public-vapid-key"

# Server-side Firebase Admin SDK config
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@example.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-your-private-key\n-----END PRIVATE KEY-----\n"
